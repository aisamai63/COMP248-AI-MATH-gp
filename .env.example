# Environment Variables for Math Inquiries LangGraph Demo
# 
# Setup:
# 1. Copy this file to prototype/.env
# 2. Fill in your actual API keys
# 3. Never commit .env to version control!

# Mistral LLM API Configuration (Required for summarization)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# SerpAPI for Web Search (Optional - for ToolAgent web search)
SERPAPI_KEY=your_serpapi_key_here

# Wolfram Alpha (Optional - for ToolAgent symbolic math)
WOLFRAM_ALPHA_KEY=your_wolfram_alpha_key_here

# Logging (Optional)
LOG_LEVEL=INFO

# Notes:
# - Get MISTRAL_API_KEY at https://console.mistral.ai
# - Get SERPAPI_KEY at https://serpapi.com
# - Get WOLFRAM_ALPHA_KEY at https://www.wolframalpha.com/api
# - If keys are missing, the app falls back to naive implementations

# Copy to .env and set your values

# LLM settings
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Tool API keys
SERPAPI_KEY=
WOLFRAM_ALPHA_KEY=

# Reflection loop settings
CONFIDENCE_THRESHOLD=0.60
MAX_ITERATIONS=3

# Retrieval/embedding settings
CHROMADB_COLLECTION_NAME=math_docs
CHROMADB_DISTANCE_METRIC=cosine
CHROMA_DB_DIR=.chroma_db
INGEST_CHUNK_SIZE=700
INGEST_CHUNK_OVERLAP=100
INGEST_BATCH_SIZE=100
DEFAULT_JSONL_FILE=sample_docs.jsonl
WEB_SEARCH_RESULTS_COUNT=3
DUCKDUCKGO_TIMEOUT_SECONDS=10

# Optional Chroma behavior
CHROMADB_ALLOW_RESET=false
CHROMADB_DISABLE_TELEMETRY=true
